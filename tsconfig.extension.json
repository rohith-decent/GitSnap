{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "outDir": "out/extension",
    "rootDir": "src",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "src/extension/**/*",
    "src/types/**/*"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "src/webview/**/*"
  ]
}