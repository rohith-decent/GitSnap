{
  "name": "gitsnap",
  "displayName": "GitSnap",
  "description": "AI-optional Git toolkit: smart commit messages, branch dashboard, stash manager, log explorer, natural-language Git commands and PR prep. Works 100% without AI.",
  "version": "2.0.0",
  "license": "MIT",
  "publisher": "RohithSGowda",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rohith-decent/GitSnap.git"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "SCM Providers",
    "AI",
    "Other"
  ],
  "keywords": [
    "git",
    "ai",
    "commit",
    "commit message",
    "branch",
    "stash",
    "git workflow",
    "ollama"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "GitSnap",
      "properties": {
        "gitsnap.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI-powered features (commit message generation, branch intelligence, natural language commands). When disabled, GitSnap works as a pure Git tool."
        },
        "gitsnap.ai.provider": {
          "type": "string",
          "enum": [
            "groq",
            "openai",
            "anthropic",
            "ollama",
            "tabby"
          ],
          "default": "groq",
          "description": "Which AI provider to use for AI-powered features."
        },
        "gitsnap.commitTemplate.scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Allowed or suggested commit scopes for team standardization."
        },
        "gitsnap.branchNaming.pattern": {
          "type": "string",
          "default": "",
          "description": "Regex pattern for branch naming validation (e.g. ^(feature|bugfix|hotfix)/.+)."
        },
        "gitsnap.ai.customSystemPrompt": {
          "type": "string",
          "default": "",
          "description": "Custom system prompt for AI commit message generation (stored locally)."
        }
      }
    },
    "commands": [
      {
        "command": "gitsnap.showMenu",
        "title": "GitSnap: Open Quick Action Menu",
        "icon": "$(menu)"
      },
      {
        "command": "gitsnap.aiCommitAndPush",
        "title": "GitSnap: Fast AI Commit & Push",
        "icon": "$(zap)"
      },
      {
        "command": "gitsnap.openCommitEditor",
        "title": "GitSnap: Open Commit Editor",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitsnap.openBranchDashboard",
        "title": "GitSnap: Open Branch Dashboard",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitsnap.openToolkit",
        "title": "GitSnap: Open Advanced Toolkit",
        "icon": "$(tools)"
      },
      {
        "command": "gitsnap.openPrPrep",
        "title": "GitSnap: PR Prep Assistant",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "gitsnap.openNlInterface",
        "title": "GitSnap: Natural Language Command",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitsnap.undoLastCommit",
        "title": "GitSnap: Undo Last Commit (Soft Reset)",
        "icon": "$(discard)"
      },
      {
        "command": "gitsnap.openSettings",
        "title": "GitSnap: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "gitsnap.setApiKey",
        "title": "GitSnap: Set API Key",
        "icon": "$(key)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "gitsnap.aiCommitAndPush",
          "group": "navigation@1"
        },
        {
          "command": "gitsnap.showMenu",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gitsnap.showMenu",
        "key": "ctrl+k g",
        "mac": "cmd+k g"
      },
      {
        "command": "gitsnap.aiCommitAndPush",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter"
      },
      {
        "command": "gitsnap.openCommitEditor",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "gitsnap.openBranchDashboard",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      },
      {
        "command": "gitsnap.openToolkit",
        "key": "ctrl+k t",
        "mac": "cmd+k t"
      },
      {
        "command": "gitsnap.openPrPrep",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "gitsnap.openNlInterface",
        "key": "ctrl+k n",
        "mac": "cmd+k n"
      },
      {
        "command": "gitsnap.undoLastCommit",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b tsconfig.extension.json tsconfig.webview.json && npm run build",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "vite build --mode extension",
    "build:webview": "vite build --mode webview",
    "watch:extension": "vite build --mode extension --watch",
    "watch:webview": "vite build --mode webview --watch",
    "watch": "concurrently \"npm run watch:extension\" \"npm run watch:webview\"",
    "package": "vsce package",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.2.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.5.0",
    "svelte": "^5.57.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "ai": "^7.0.87",
    "groq-sdk": "^1.6.0",
    "simple-git": "^3.36.0"
  }
}