{
  "name": "gitsnap",
  "displayName": "GitSnap",
  "description": "One-click AI-powered Git commit and push",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.134.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rohith-decent/GitSnap.git"
  },
  "publisher": "RSG",
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitsnap.aiCommitAndPush",
        "title": "GitSnap: AI Commit & Push",
        "icon": "$(zap)"
      },
      {
        "command": "gitsnap.openSettings",
        "title": "GitSnap: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "gitsnap.setApiKey",
        "title": "GitSnap: Set API Key",
        "icon": "$(key)"
      }
    ]
  },
  "scripts": {
    "build:extension": "vite build --mode extension",
    "build:webview": "vite build --mode webview",
    "build": "npm run build:extension && npm run build:webview",
    "watch:extension": "vite build --mode extension --watch",
    "watch:webview": "vite build --mode webview --watch",
    "watch": "concurrently \"npm run watch:extension\" \"npm run watch:webview\"",
    "compile": "tsc -b tsconfig.extension.json tsconfig.webview.json && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.5.0",
    "svelte": "^5.57.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "ai": "^7.0.87",
    "groq-sdk": "^1.6.0",
    "simple-git": "^3.36.0"
  }
}